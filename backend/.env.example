# ===== 应用配置 =====
APP_NAME=NovelReadingSystem
APP_ENV=development
DEBUG=true

# ===== 数据库配置 =====
# 开发环境使用 SQLite，生产环境使用 PostgreSQL
DATABASE_URL=sqlite:///./dev.db
# PostgreSQL 示例: postgresql+psycopg2://user:password@localhost:5432/novel_db

# ===== JWT 认证配置 =====
# 生产环境必须设置为强随机字符串（至少32字节），可通过 openssl rand -hex 32 生成
JWT_SECRET_KEY=change-me-to-a-strong-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== CORS 配置 =====
# 逗号分隔的允许来源列表，生产环境禁止使用 *
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== 管理员初始化 =====
# 首次启动时自动创建管理员账号（仅当不存在时）
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=change-me-to-a-strong-password

# ===== 数据源配置 =====
# 数据源模式: demo（演示数据）/ real（真实数据源）
DATA_SOURCE_MODE=demo
# 真实数据源 API 地址（仅 real 模式使用）
DATA_SOURCE_API_URL=
# 数据源请求超时（秒）
DATA_SOURCE_TIMEOUT_SECONDS=10
# 数据源最大重试次数
DATA_SOURCE_MAX_RETRIES=3
# 缓存 TTL（秒）
CACHE_TTL_SECONDS=300

# ===== 限流配置 =====
# 登录接口限流: 每分钟最大请求数
LOGIN_RATE_LIMIT=5
# 注册接口限流: 每分钟最大请求数
REGISTER_RATE_LIMIT=5

# ===== 分页配置 =====
MAX_PAGE_SIZE=50
DEFAULT_PAGE_SIZE=20